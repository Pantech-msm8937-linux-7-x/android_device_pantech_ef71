     TinyHAL configuration for the EF71 on the mainline kernel: the Q6
     ASM/ADM/AFE path of the ADSP into a WCD9335 on SLIMbus.

     Playback runs from MultiMedia1 (pcm 0) into SLIMBUS_0_RX and the codec
     AIF1, capture from SLIMBUS_0_TX into MultiMedia2 (pcm 1).

     The loudspeaker is a WSA8810 on the WCD9335 SoundWire master, fed by
     interpolator INT7. Its DAC port stays switched on: the amplifier only
     joins the SoundWire stream with the ports switched on when the stream
     starts, so a stream started on another output (a call on the earpiece)
     would never reach it.

     q6asm-dai only takes periods and buffers in steps of 480 frames, so the
     streams ask for such a size: tinyalsa derives the start and stop
     thresholds from the requested size, and a period the kernel rounds up
     would leave the stop threshold below the buffer and stop the stream
     with an XRUN as soon as it starts.

     Every SLIM RX port routed to AIF1 has to feed an interpolator: the
     ports form one multi-channel group, and one that nobody drains
     overflows and stalls the others. The mono outputs therefore route only
     SLIM RX0.

     The input device paths own AMIC MUX8. TinyHAL applies them only when
     the input device changes, so the stream paths must leave it alone, or
     every recording after the first would read a disconnected ADC.
-->
<audiohal>
    <mixer card="0">
        <init>
            <ctl name="SLIMBUS_0_RX Audio Mixer MultiMedia1" val="0"/>
            <ctl name="MultiMedia2 Mixer SLIMBUS_0_TX" val="0"/>
            <ctl name="SLIMBUS_0_RX Voice Mixer VoiceMMode1" val="0"/>
            <ctl name="VoiceMMode1 Capture Mixer SLIMBUS_0_TX" val="0"/>
            <ctl name="SLIMBUS_0_RX Voice Mixer VoLTE" val="0"/>
            <ctl name="VoLTE Capture Mixer SLIMBUS_0_TX" val="0"/>
            <ctl name="SLIMBUS_0_RX Voice Mixer CS-Voice" val="0"/>
            <ctl name="CS-Voice Capture Mixer SLIMBUS_0_TX" val="0"/>
            <ctl name="RX0 Digital Volume" val="84"/>
            <ctl name="RX1 Digital Volume" val="84"/>
            <ctl name="RX2 Digital Volume" val="84"/>
            <ctl name="RX7 Digital Volume" val="81"/>
            <ctl name="SpkrLeft PA Volume" val="12"/>
            <ctl name="SpkrLeft DAC Switch" val="1"/>
            <ctl name="HPHL Volume" val="20"/>
            <ctl name="HPHR Volume" val="20"/>
            <ctl name="RX HPH Mode" val="CLS_H_HIFI"/>
        </init>
    </mixer>

    <device name="global">
        <path name="pcm_out_en">
            <ctl name="SLIMBUS_0_RX Audio Mixer MultiMedia1" val="1"/>
        </path>
        <path name="pcm_out_dis">
            <ctl name="SLIMBUS_0_RX Audio Mixer MultiMedia1" val="0"/>
        </path>
        <path name="pcm_in_en">
            <ctl name="MultiMedia2 Mixer SLIMBUS_0_TX" val="1"/>
            <ctl name="AIF1_CAP Mixer SLIM TX8" val="1"/>
            <ctl name="SLIM TX8 MUX" val="DEC8"/>
            <ctl name="ADC MUX8" val="AMIC"/>
        </path>
        <path name="fm_in_en">
            <ctl name="MultiMedia2 Mixer INT_FM_TX" val="1"/>
        </path>
        <path name="fm_in_dis">
            <ctl name="MultiMedia2 Mixer INT_FM_TX" val="0"/>
        </path>
        <path name="pcm_in_dis">
            <ctl name="MultiMedia2 Mixer SLIMBUS_0_TX" val="0"/>
            <ctl name="AIF1_CAP Mixer SLIM TX8" val="0"/>
            <ctl name="SLIM TX8 MUX" val="ZERO"/>
        </path>
        <path name="voice_mmode1_en">
            <ctl name="SLIMBUS_0_RX Voice Mixer VoiceMMode1" val="1"/>
            <ctl name="VoiceMMode1 Capture Mixer SLIMBUS_0_TX" val="1"/>
        </path>
        <path name="voice_mmode1_dis">
            <ctl name="SLIMBUS_0_RX Voice Mixer VoiceMMode1" val="0"/>
            <ctl name="VoiceMMode1 Capture Mixer SLIMBUS_0_TX" val="0"/>
        </path>
        <path name="voice_volte_en">
            <ctl name="SLIMBUS_0_RX Voice Mixer VoLTE" val="1"/>
            <ctl name="VoLTE Capture Mixer SLIMBUS_0_TX" val="1"/>
        </path>
        <path name="voice_volte_dis">
            <ctl name="SLIMBUS_0_RX Voice Mixer VoLTE" val="0"/>
            <ctl name="VoLTE Capture Mixer SLIMBUS_0_TX" val="0"/>
        </path>
        <path name="voice_cs_en">
            <ctl name="SLIMBUS_0_RX Voice Mixer CS-Voice" val="1"/>
            <ctl name="CS-Voice Capture Mixer SLIMBUS_0_TX" val="1"/>
        </path>
        <path name="voice_cs_dis">
            <ctl name="SLIMBUS_0_RX Voice Mixer CS-Voice" val="0"/>
            <ctl name="CS-Voice Capture Mixer SLIMBUS_0_TX" val="0"/>
        </path>
        <path name="voice_in_en">
            <ctl name="AIF1_CAP Mixer SLIM TX8" val="1"/>
            <ctl name="SLIM TX8 MUX" val="DEC8"/>
            <ctl name="ADC MUX8" val="AMIC"/>
        </path>
        <path name="voice_in_dis">
            <ctl name="AIF1_CAP Mixer SLIM TX8" val="0"/>
            <ctl name="SLIM TX8 MUX" val="ZERO"/>
        </path>
    </device>

    <device name="earpiece">
        <path name="on">
            <ctl name="SLIM RX0 MUX" val="AIF1_PB"/>
            <ctl name="SLIM RX1 MUX" val="ZERO"/>
            <ctl name="RX INT0_1 MIX1 INP0" val="RX0"/>
            <ctl name="RX INT0 DEM MUX" val="CLSH_DSM_OUT"/>
        </path>
        <path name="off">
            <ctl name="RX INT0_1 MIX1 INP0" val="ZERO"/>
        </path>
    </device>

    <device name="speaker">
        <path name="on">
            <ctl name="SLIM RX0 MUX" val="AIF1_PB"/>
            <ctl name="SLIM RX1 MUX" val="ZERO"/>
            <ctl name="RX INT7_1 MIX1 INP0" val="RX0"/>
        </path>
        <path name="off">
            <ctl name="RX INT7_1 MIX1 INP0" val="ZERO"/>
        </path>
    </device>

    <device name="headphone">
        <path name="on">
            <ctl name="SLIM RX0 MUX" val="AIF1_PB"/>
            <ctl name="SLIM RX1 MUX" val="AIF1_PB"/>
            <ctl name="RX INT1_2 MUX" val="RX0"/>
            <ctl name="RX INT2_2 MUX" val="RX1"/>
            <ctl name="RX INT1 DEM MUX" val="CLSH_DSM_OUT"/>
            <ctl name="RX INT2 DEM MUX" val="CLSH_DSM_OUT"/>
        </path>
        <path name="off">
            <ctl name="RX INT1_2 MUX" val="ZERO"/>
            <ctl name="RX INT2_2 MUX" val="ZERO"/>
        </path>
    </device>

    <device name="headset">
        <path name="on">
            <ctl name="SLIM RX0 MUX" val="AIF1_PB"/>
            <ctl name="SLIM RX1 MUX" val="AIF1_PB"/>
            <ctl name="RX INT1_2 MUX" val="RX0"/>
            <ctl name="RX INT2_2 MUX" val="RX1"/>
            <ctl name="RX INT1 DEM MUX" val="CLSH_DSM_OUT"/>
            <ctl name="RX INT2 DEM MUX" val="CLSH_DSM_OUT"/>
        </path>
        <path name="off">
            <ctl name="RX INT1_2 MUX" val="ZERO"/>
            <ctl name="RX INT2_2 MUX" val="ZERO"/>
        </path>
    </device>

    <!-- Handset microphone on AMIC3, biased by MIC BIAS1 -->
    <device name="mic">
        <path name="on">
            <ctl name="AMIC MUX8" val="ADC3"/>
            <ctl name="ADC3 Volume" val="14"/>
        </path>
    </device>

    <!--
         The camcorder records from the handset microphone as on the vendor
         software, where AMIC4 only served as the second microphone of
         speakerphone and noise suppression. (A device without an "off"
         path needs the configmgr fix that releases it, or the mux keeps
         the value of the input device enabled last.)
    -->
    <device name="back mic">
        <path name="on">
            <ctl name="AMIC MUX8" val="ADC3"/>
            <ctl name="ADC3 Volume" val="14"/>
        </path>
    </device>

    <!-- FM tuner: its stream sets the route, see "fm tuner" below -->
    <device name="fm_tuner">
    </device>

    <!-- Headset microphone on AMIC2, biased by MIC BIAS2 -->
    <device name="headset_in">
        <path name="on">
            <ctl name="AMIC MUX8" val="ADC2"/>
            <ctl name="ADC2 Volume" val="14"/>
        </path>
    </device>

    <stream type="pcm" dir="out" card="0" device="0"
            rate="48000" period_size="960" period_count="4">
        <enable path="pcm_out_en"/>
        <disable path="pcm_out_dis"/>
    </stream>

    <stream type="pcm" dir="in" card="0" device="1"
            rate="48000" period_size="960" period_count="4">
        <enable path="pcm_in_en"/>
        <disable path="pcm_in_dis"/>
    </stream>

    <!--
         FM radio: the audio of the WCNSS FM receiver comes into the DSP on
         its INT_FM_TX port, not from the codec. Opened for the FM tuner input
         source on the MultiMedia2 front end of the normal capture stream.
    -->
    <stream name="fm tuner" type="pcm" dir="in" card="0" device="1"
            rate="48000" period_size="960" period_count="4">
        <enable path="fm_in_en"/>
        <disable path="fm_in_dis"/>
    </stream>

    <!--
         Call volume and microphone mute: the volume sets the digital gain
         of the interpolators a call plays on (earpiece INT0, loudspeaker
         INT7, headphones the mix inputs of INT1 and INT2) from 6 dB above
         their gain outside calls at the highest volume to 30 dB below
         that; the DSP mutes the microphone of calls.
    -->
    <stream name="global" type="hw" dir="out">
        <set name="voice volume ctls"
             val="RX0 Digital Volume,RX7 Digital Volume,RX1 Mix Digital Volume,RX2 Mix Digital Volume"/>
        <set name="voice volume max db" val="6"/>
        <set name="voice volume range db" val="30"/>
        <set name="voice mute ctl" val="Voice Tx Mute"/>
    </stream>

    <!--
         Voice calls: the modem and the DSP carry the audio. The HAL opens both
         directions of the front end of the session the radio interface layer
         names (vsid, in hex) to start it on SLIMBUS_0. The output streams
         route the output device, the mic stream the microphone that goes
         with it.
    -->
    <stream name="voice call 11C05000" type="hw" dir="out">
        <enable path="voice_mmode1_en"/>
        <disable path="voice_mmode1_dis"/>
        <set name="card" val="0"/>
        <set name="device" val="3"/>
    </stream>

    <stream name="voice call 10C02000" type="hw" dir="out">
        <enable path="voice_volte_en"/>
        <disable path="voice_volte_dis"/>
        <set name="card" val="0"/>
        <set name="device" val="4"/>
    </stream>

    <stream name="voice call 10C01000" type="hw" dir="out">
        <enable path="voice_cs_en"/>
        <disable path="voice_cs_dis"/>
        <set name="card" val="0"/>
        <set name="device" val="5"/>
    </stream>

    <stream name="voice call mic" type="hw" dir="in">
        <enable path="voice_in_en"/>
        <disable path="voice_in_dis"/>
    </stream>
</audiohal>
