service vendor.charger_led /vendor/bin/charger_led
    class charger
    user system
    group system
    file /dev/kmsg w
    oneshot
    disabled

# Off-mode charging does not run early-boot, where init.ef71.rc loads the
# LP5523 driver: load it for the charger, which then shows the charging
# state itself as on the stock kernel (red dimming while charging, green
# when full)
on charger
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules leds-lp5523-pantech offline_charger=1
