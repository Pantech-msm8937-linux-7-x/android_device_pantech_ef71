cc_library_shared {
    name: "libwifi-hal-ef71",
    vendor: true,
    srcs: ["wifi_hal.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    header_libs: ["libhardware_legacy_headers"],
    shared_libs: [
        "liblog",
        "libnl",
    ],
}

prebuilt_etc {
    name: "wifi_vendor_hal_ef71.xml",
    src: "vendor_hal.xml",
    filename: "ef71.xml",
    sub_dir: "wifi/vendor_hals",
    vendor: true,
    required: ["libwifi-hal-ef71"],
}
