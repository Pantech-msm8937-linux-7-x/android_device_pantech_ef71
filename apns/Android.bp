// The Lineage APN list with the initial attach APN of the Korean VoLTE
// carriers set to the IMS APN and the internet APNs of the Korean carriers
// set to IPv4v6, bind mounted over it by init.ef71.rc
genrule {
    name: "ef71_apns_conf_gen",
    srcs: [":apns-conf"],
    out: ["ef71_apns-conf.xml"],
    cmd: "sed -e '/mcc=\"450\" mnc=\"08\" carrier=\"KT IA\"/s/ apn=\"[^\"]*\"/ apn=\"ims\"/' " +
        "-e '/mcc=\"450\" mnc=\"06\" carrier=\"LG uplus IA\"/s/ apn=\"[^\"]*\"/ apn=\"ims\"/' " +
        "-e '/mcc=\"450\" mnc=\"05\" carrier=\"SKT IA\"/s/ apn=\"[^\"]*\"/ apn=\"ims\"/' " +
        "-e '/mcc=\"450\" mnc=\"08\" carrier=\"KT\" apn=\"lte.ktfwing.com\"/s/ protocol=\"[^\"]*\"//g; /mcc=\"450\" mnc=\"08\" carrier=\"KT\" apn=\"lte.ktfwing.com\"/s/ roaming_protocol=\"[^\"]*\"//g; /mcc=\"450\" mnc=\"08\" carrier=\"KT\" apn=\"lte.ktfwing.com\"/s| />| protocol=\"IPV4V6\" roaming_protocol=\"IPV4V6\" />|' " +
        "-e '/mcc=\"450\" mnc=\"05\" carrier=\"SKT LTE INTERNET\" apn=\"lte.sktelecom.com\"/s/ protocol=\"[^\"]*\"//g; /mcc=\"450\" mnc=\"05\" carrier=\"SKT LTE INTERNET\" apn=\"lte.sktelecom.com\"/s/ roaming_protocol=\"[^\"]*\"//g; /mcc=\"450\" mnc=\"05\" carrier=\"SKT LTE INTERNET\" apn=\"lte.sktelecom.com\"/s| />| protocol=\"IPV4V6\" roaming_protocol=\"IPV4V6\" />|' " +
        "-e '/mcc=\"450\" mnc=\"06\" carrier=\"LG uplus\" apn=\"internet.lguplus.co.kr\"/s/ protocol=\"[^\"]*\"//g; /mcc=\"450\" mnc=\"06\" carrier=\"LG uplus\" apn=\"internet.lguplus.co.kr\"/s/ roaming_protocol=\"[^\"]*\"//g; /mcc=\"450\" mnc=\"06\" carrier=\"LG uplus\" apn=\"internet.lguplus.co.kr\"/s| />| protocol=\"IPV4V6\" roaming_protocol=\"IPV4V6\" />|' " +
        "$(in) > $(out) && " +
        "grep -q 'mcc=\"450\" mnc=\"08\" carrier=\"KT IA\" apn=\"ims\"' $(out) && " +
        "grep -q 'mcc=\"450\" mnc=\"06\" carrier=\"LG uplus IA\" apn=\"ims\"' $(out) && " +
        "grep -q 'mcc=\"450\" mnc=\"05\" carrier=\"SKT IA\" apn=\"ims\"' $(out) && " +
        "grep -q 'mcc=\"450\" mnc=\"08\" carrier=\"KT\" apn=\"lte.ktfwing.com\".* protocol=\"IPV4V6\" roaming_protocol=\"IPV4V6\"' $(out) && " +
        "grep -q 'mcc=\"450\" mnc=\"05\" carrier=\"SKT LTE INTERNET\" apn=\"lte.sktelecom.com\".* protocol=\"IPV4V6\" roaming_protocol=\"IPV4V6\"' $(out) && " +
        "grep -q 'mcc=\"450\" mnc=\"06\" carrier=\"LG uplus\" apn=\"internet.lguplus.co.kr\".* protocol=\"IPV4V6\" roaming_protocol=\"IPV4V6\"' $(out)",
}

prebuilt_etc {
    name: "ef71_apns-conf.xml",
    src: ":ef71_apns_conf_gen",
    vendor: true,
}
