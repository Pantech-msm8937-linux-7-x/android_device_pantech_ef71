allow init proc_boot_reason:file r_file_perms;

# Firmware
allow init firmware_file:filesystem getattr;

# LED
allow init sysfs_leds:lnk_file r_file_perms;

# SDHCI
allow init sysfs_kernel_sdhci_msm:file w_file_perms;

# SoC info
r_dir_file(init, sysfs_socinfo)

# The wifi and bootreceiver tracing instances of init.rc: on 7.3 tracefs
# creates their files itself
dontaudit init { debugfs_bootreceiver_tracing debugfs_wifi_tracing }:dir { add_name write };
