# Firmware
/firmware                                                     u:object_r:firmware_file:s0
/bt_firmware                                                  u:object_r:bt_firmware_file:s0
# The legacy policy only labels them under /vendor
/system/vendor/firmware(/.*)?                                 u:object_r:vendor_firmware_file:s0
/persist(/.*)?                                                u:object_r:mnt_vendor_file:s0
/mnt/vendor/persist(/.*)?                                     u:object_r:mnt_vendor_file:s0
/mnt/vendor/persist/WCNSS_qcom_wlan_nv.bin                    u:object_r:wcnss_persist_file:s0

# Executables
/(vendor|system/vendor)/bin/charger_led				u:object_r:charger_led_exec:s0
/(vendor|system/vendor)/bin/edgnss-daemon			u:object_r:location_exec:s0
/(vendor|system/vendor)/bin/awk					u:object_r:vendor_toolbox_exec:s0

# HALs
/(vendor|system/vendor)/bin/hw/android\.hardware\.lights-service\.ef71                    u:object_r:hal_light_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.thermal@2\.0-service\.qti\.ef71	u:object_r:hal_thermal_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.gatekeeper@1\.0-service\.software	u:object_r:hal_gatekeeper_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.media\.c2@1\.2-service-v4l2(-32|-64)?	u:object_r:mediacodec_exec:s0

# Graphics: Mesa and minigbm. Their own policies only know /vendor, not the
# /system/vendor this vendor tree lives in.
/(vendor|system/vendor)/lib(64)?/libgallium_dri\.so				u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/hw/vulkan\.[a-z0-9]+\.so			u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libminigbm_gralloc_msm\.so			u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/hw/gralloc\.minigbm_msm\.so			u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/hw/android\.hardware\.graphics\.mapper@4\.0-impl\.minigbm_msm\.so	u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.graphics\.allocator@4\.0-service\.minigbm_msm	u:object_r:hal_graphics_allocator_default_exec:s0
# The render node Mesa opens, untrusted apps among them, which may not use
# a graphics_device; card0 stays the composer's
/dev/dri						u:object_r:gpu_device:s0
/dev/dri/renderD[0-9]+					u:object_r:gpu_device:s0

# Input devices
/(vendor|system/vendor)/usr/idc(/.*)?                         u:object_r:vendor_idc_file:s0
/(vendor|system/vendor)/usr/keylayout(/.*)?                   u:object_r:vendor_keylayout_file:s0

# Rild
/(vendor|system/vendor)/radio/qcril_database/qcril\.db			u:object_r:rild_file:s0

# Shell Script
/(vendor|system/vendor)/bin/init\.ef71\.apn\.sh				u:object_r:qti_init_shell_exec:s0
/(vendor|system/vendor)/bin/ef71_modemcfg				u:object_r:ef71_modemcfg_exec:s0

# AT ports of the modem for init.ef71.apn.sh, as smd8 was
/dev/wwan0at[0-9]+					u:object_r:smd_device:s0
# rpmsg_char endpoints, for the DIAG channel of the modem
/dev/rpmsg_ctrl[0-9]+					u:object_r:ef71_rpmsg_device:s0
/dev/rpmsg[0-9]+					u:object_r:ef71_rpmsg_device:s0

# Sensors
/persist/sensors(/.*)?                          u:object_r:sensors_persist_file:s0

# Subsystems
/sys/devices(/platform)?/soc/4080000\.qcom,mss/subsys[0-9]/state	u:object_r:sysfs_modem_subsys:s0

# Sys files
/sys/devices(/platform)?/soc/78b6000\.i2c/i2c-2/2-[0-9a-f]+/leds(/.*)?		u:object_r:sysfs_leds:s0
/sys/devices(/platform)?/soc/leds-qpnp-[0-9]+/leds(/.*)?				u:object_r:sysfs_leds:s0

# The vendor tree lives in /system/vendor, out of reach of the
# /(odm|vendor/odm)/etc rule every domain may read
/system/vendor/odm/etc(/.*)?						u:object_r:vendor_configs_file:s0

# Bluetooth address
/(vendor|system/vendor)/bin/hw/bdaddr                    u:object_r:set_bdaddr_exec:s0
