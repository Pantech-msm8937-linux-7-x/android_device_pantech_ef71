# Boot reason
genfscon proc  /sys/kernel/boot_reason   u:object_r:proc_boot_reason:s0

# Double tap to wake (EF71S: Atmel mXT641T, EF71AS: FocalTech FT8716)
genfscon sysfs /devices/platform/soc@0/78b7000.i2c/i2c-0/0-004a/dt2w_enable	u:object_r:sysfs_tap_to_wake:s0
genfscon sysfs /devices/platform/soc@0/78b7000.i2c/i2c-0/0-0038/dt2w_enable	u:object_r:sysfs_tap_to_wake:s0

# FDT
