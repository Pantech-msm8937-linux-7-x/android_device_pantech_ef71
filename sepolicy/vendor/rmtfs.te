type rmtfs, domain;
type rmtfs_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(rmtfs)

allow rmtfs kmsg_debug_device:chr_file rw_file_perms;

allow rmtfs block_device:dir search;
allow rmtfs modem_efs_partition_device:blk_file rw_file_perms;
allow rmtfs rmtfs_device:chr_file { open read write };
allow rmtfs self:capability net_admin;
allow rmtfs self:qipcrtr_socket { bind create getattr read setopt write };
allow rmtfs vendor_sysfs_mss:dir { open read search };
allow rmtfs vendor_sysfs_remoteproc:dir { open read search };
allow rmtfs vendor_sysfs_remoteproc:file rw_file_perms;
allow rmtfs vendor_sysfs_rmtfs:dir search;
allow rmtfs vendor_sysfs_rmtfs:file { open read };
